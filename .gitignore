# Generated by the engine
Binaries/
Intermediate/
Saved/
DerivedDataCache/
Build/
Builds/

# IDE
.vs/
.idea/
.agents/
*.sln
*.suo
*.VC.db
*.VC.opendb
Plugins/Developer/RiderLink

# Engine-generated project files
*.xcodeproj
*.xcworkspace

# Compiled objects and libraries
*.o
*.obj
*.pdb
*.lib
*.dll
*.exe

# Raw source art
SourceArt/**/*.png
SourceArt/**/*.tga

# Auto-generated by the editor — never commit
Content/Collections/
Content/Developers/
Content/__ExternalActors__/
Content/__ExternalObjects__/

# Exclude all content by default, then whitelist first-party folders.
# Content/ThirdParty/ (marketplace packs) stays local-only — size and
# redistribution terms — so it is deliberately NOT re-included here.
Content/*
!Content/IronField/
!Content/IronField/**

# Local user and dev settings
Config/*PerProjectUserSettings.ini
.mcp.json
mcp_proxy.py
test_game_flow.py
