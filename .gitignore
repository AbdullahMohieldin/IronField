# Generated by the engine
Binaries/
Intermediate/
Saved/
DerivedDataCache/
Build/
Builds/

# IDE
.vs/
.idea/
.agents/
*.sln
*.suo
*.VC.db
*.VC.opendb
Plugins/Developer/RiderLink

# Engine-generated project files
*.xcodeproj
*.xcworkspace

# Compiled objects and libraries
*.o
*.obj
*.pdb
*.lib
*.dll
*.exe

# Raw source art
SourceArt/**/*.png
SourceArt/**/*.tga

# Auto-generated by the editor — never commit
Content/Collections/
Content/Developers/
Content/__ExternalActors__/
Content/__ExternalObjects__/

# Exclude all content by default, then whitelist first-party folders and tracked third-party essentials.
# Content/ThirdParty/ marketplace packs generally stay local-only due to size and redistribution terms,
# except for the minimal tracked pickup meshes/audio referenced by BP_HealPickup and NOTICE.md.
Content/*
!Content/IronField/
!Content/IronField/**
!Content/ThirdParty/
Content/ThirdParty/*
!Content/ThirdParty/NOTICE.md
!Content/ThirdParty/PotionMeshes/
!Content/ThirdParty/PotionMeshes/**
!Content/ThirdParty/PotionSound/
!Content/ThirdParty/PotionSound/**

# Local user and dev settings
Config/*PerProjectUserSettings.ini
.mcp.json
mcp_proxy.py
test_game_flow.py
